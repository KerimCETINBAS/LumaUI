{
  "name": "lumaui-monorepo",
  "version": "0.2.3",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "addons/core",
    "addons/editor"
  ],
  "scripts": {
    "check": "npm run check --workspaces",
    "build": "node tools/build.mjs",
    "deploy": "node tools/build.mjs --deploy",
    "test": "node --test tests/*.test.cjs",
    "test:integration": "node tests/collections.integration.cjs",
    "release:check": "node tools/release.mjs --check",
    "build:release": "node tools/release.mjs",
    "presets:generate": "node tools/generate-builtin-presets.mjs",
    "icons:preview": "node tools/build-icons.mjs --preview",
    "catalogs:generate": "node tools/generate-spell-catalog.mjs && node tools/generate-icon-catalog.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "fengari-node-cli": "^0.1.0",
    "wuira": "^0.3.0"
  }
}
